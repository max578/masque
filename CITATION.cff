repository-code: "https://github.com/max578/masque"
url: "https://max578.github.io/masque/"
license: MIT
version: 0.18.0
keywords:
  - synthetic-data
  - data-masking
  - tabular-data
  - reproducibility
  - confidential-data-sharing
  - r-package
