linters: linters_with_defaults(
    line_length_linter(80L),
    object_name_linter(styles = c("snake_case", "SCREAMING_SNAKE_CASE", "symbols")),
    assignment_linter(),
    seq_linter(),
    T_and_F_symbol_linter(),
    commented_code_linter(),
    indentation_linter = NULL,
    commas_linter = NULL,
    spaces_inside_linter = NULL,
    paren_body_linter = NULL
  )
exclusions: list(
    "tests/testthat.R",
    "tests/spelling.R",
    "R/detect_rules.R" = list(object_name_linter = Inf),
    "R/propose_roles.R" = list(object_name_linter = Inf),
    "R/synthesise_numeric.R" = list(object_name_linter = Inf),
    "R/recipe_apply.R" = list(object_usage_linter = Inf),
    "R/roles_validate.R" = list(object_usage_linter = Inf),
    "tests/testthat/test-detect_plot.R" = list(object_usage_linter = Inf)
  )
